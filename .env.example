# ============================================================
# RADAR DE CONFORMIDADE FISCAL — VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com dados de produção!
# ============================================================

# ========================
# SERVIDOR
# ========================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ========================
# JWT / AUTENTICAÇÃO
# ========================
# IMPORTANTE: Em produção, use um segredo forte e aleatório de 64+ caracteres
JWT_SECRET=gere-um-segredo-forte-com-openssl-rand-hex-64-aqui
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ========================
# BANCO DE DADOS / SUPABASE
# ========================
DATABASE_PATH=./data/radar_fiscal.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ========================
# SEFAZ — WebServices
# ========================
# Ambiente: 1 = Produção, 2 = Homologação
SEFAZ_TP_AMB=2

# SVRS Homologação (padrão — normalmente não precisa alterar)
# SEFAZ_SVRS_HOM_EVENTO=https://nfe-homologacao.svrs.rs.gov.br/ws/recepcaoevento/recepcaoevento4.asmx
# SEFAZ_SVRS_HOM_CONSULTA=https://nfe-homologacao.svrs.rs.gov.br/ws/NfeConsulta/NfeConsulta4.asmx
# SEFAZ_SVRS_HOM_DIST=https://hom1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx

# SVRS Produção
# SEFAZ_SVRS_PROD_EVENTO=https://nfe.svrs.rs.gov.br/ws/recepcaoevento/recepcaoevento4.asmx
# SEFAZ_SVRS_PROD_CONSULTA=https://nfe.svrs.rs.gov.br/ws/NfeConsulta/NfeConsulta4.asmx
# SEFAZ_SVRS_PROD_DIST=https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx

# ========================
# COMITÊ GESTOR DO IBS (CGIBS)
# ========================
CGIBS_API_URL=https://api-homologacao.cgibs.gov.br/v1
CGIBS_API_KEY=
CGIBS_TIMEOUT_MS=15000

# ========================
# RECEITA FEDERAL (RFB)
# ========================
RFB_API_URL=https://api-homologacao.receita.fazenda.gov.br/rtc/v1
RFB_BEARER_TOKEN=
RFB_TIMEOUT_MS=20000

# ========================
# INTEGRAÇÃO ERP / SAP
# ========================
ERP_TIPO=SAP_S4HANA
ERP_ENDPOINT_URL=
ERP_SYSTEM_ID=
ERP_CLIENT_NUMBER=100
ERP_API_KEY=
ERP_WEBHOOK_URL=

# ========================
# CERTIFICADO DIGITAL A1
# ========================
# Diretório onde os .PFX criptografados são armazenados
CERT_STORAGE_DIR=./data/certificates
# Chave mestra AES-256 para criptografar os PFX (gerar com: openssl rand -hex 32)
CERT_ENCRYPTION_KEY=

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MIN=15
SEFAZ_RATE_LIMIT=8

# ========================
# GOOGLE GEMINI AI (existente)
# ========================
GEMINI_API_KEY=
