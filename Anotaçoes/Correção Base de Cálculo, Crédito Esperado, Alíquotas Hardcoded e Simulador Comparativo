### Componente 3: Simulador Comparativo no KPI Service

#### [MODIFY] [kpiAggregationService.ts](file:///c:/Automacoes/Radar%20Conformidade%20Fiscal/server/services/kpiAggregationService.ts)

Adicionar campos ao `KpiTotals`:
```typescript
// Simulador de Transição
totalBaseLiquida: number;      // vNF - tributos atuais (reais ou inferidos)
totalCbsSimulada: number;      // baseLiquida × aliq CBS parâmetros
totalIbsEstSimulada: number;   // baseLiquida × aliq IBS Est parâmetros
totalIbsMunSimulada: number;   // baseLiquida × aliq IBS Mun parâmetros
totalRegimeAtual: number;      // soma ICMS+IPI+ISS+PIS+COFINS (reais+inferidos)
totalRegimeReforma: number;    // CBS + IBS simulados
deltaTransicao: number;        // reforma - atual
```

No `accumulateDoc()`, a lógica:
```typescript
// Determinar se precisa inferir
const crt = doc.regime_tributario || doc.crt || '3';
const tipoDoc = (doc.tipo_doc || '').toUpperCase();
const isSimples = crt === '1' || crt === '4';
const isCte = tipoDoc === 'CTE' || tipoDoc === '57';

// Tributos reais do XML
let icms = Number(doc.valor_icms) || 0;
let pis = Number(doc.valor_pis) || 0;
let cofins = Number(doc.valor_cofins) || 0;
let ipi = Number(doc.valor_ipi) || 0;
let iss = Number(doc.valor_iss) || 0;
const vTotal = Number(doc.valor_total) || 0;

// Inferência quando XML não destaca
if (isSimples && icms === 0 && pis === 0 && cofins === 0) {
  // Usar alíquotas médias SN dos parametros_inferencia
  icms = vTotal * (paramSN.icms_medio / 100);
  pis = vTotal * (paramSN.pis_medio / 100);
  cofins = vTotal * (paramSN.cofins_medio / 100);
}
if (isCte && pis === 0 && cofins === 0) {
  // Usar alíquotas médias CT-e dos parametros_inferencia
  pis = vTotal * (paramCte.pis_medio / 100);
  cofins = vTotal * (paramCte.cofins_medio / 100);
}

const tributosAtuais = icms + ipi + iss + pis + cofins;
const baseLiquida = Math.max(0, vTotal - tributosAtuais);

// Aplicar alíquotas dos Parâmetros Fiscais (2026 = CBS 0.9%, IBS Est 0.01%)
const cbsSim = baseLiquida * (regraAno.aliquotaCbs / 100);
const ibsEstSim = baseLiquida * (regraAno.aliquotaIbsEstadual / 100);
const ibsMunSim = baseLiquida * (regraAno.aliquotaIbsMunicipal / 100);
const regimeReforma = cbsSim + ibsEstSim + ibsMunSim;

totals.totalBaseLiquida += baseLiquida;
totals.totalCbsSimulada += cbsSim;
totals.totalIbsEstSimulada += ibsEstSim;
totals.totalIbsMunSimulada += ibsMunSim;
totals.totalRegimeAtual += tributosAtuais;
totals.totalRegimeReforma += regimeReforma;
totals.deltaTransicao = totals.totalRegimeReforma - totals.totalRegimeAtual;
```

